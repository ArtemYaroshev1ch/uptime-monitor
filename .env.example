# Template for local configuration: cp .env.example .env
# .env is git-ignored; never commit real secrets.
# Plain KEY=value lines only: the Makefile sources this file with sh.
# Every variable is described in README.md (Configuration).

# dev (text logs) or prod (JSON logs).
APP_ENV=dev

# debug, info, warn or error.
LOG_LEVEL=info

# Public REST API listen address.
# On Windows, 127.0.0.1:8080 avoids the firewall prompt for local runs.
HTTP_ADDR=:8080

# How long in-flight requests may take to finish after SIGTERM.
# Must be lower than the container stop grace period (30s).
SHUTDOWN_TIMEOUT=25s

# PostgreSQL connection URL (contains the password: never log or commit it).
# For binaries started on the host (make run-api) against the database of
# docker-compose.yml (make db). Inside the compose stack the services use
# the "postgres" host instead; docker-compose.yml sets that itself.
# 127.0.0.1 rather than localhost: on Windows localhost resolves to ::1 first,
# where nothing listens, and every connection waits ~2 s before falling back.
DATABASE_URL=postgres://uptime:uptime@127.0.0.1:5432/uptime?sslmode=disable

# Maximum connections in the pool of one api process.
DB_MAX_CONNS=10

# Secret that signs access tokens (JWT, HS256): at least 32 bytes.
# Anyone who knows it can log in as any user. The value below is public and
# only lets the local stack start as is: the API refuses it with
# APP_ENV=prod. Generate a real one with: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789

# Lifetime of an access token (Go duration: 30m, 12h, ...).
ACCESS_TOKEN_TTL=12h

# true only behind a reverse proxy that appends the client address to
# X-Forwarded-For: the auth rate limit then keys on that address instead
# of the proxy's. With direct access, clients could spoof the header.
TRUST_PROXY_HEADERS=false

# Maximum number of monitors per user.
MAX_MONITORS_PER_USER=20

# DEVELOPMENT ONLY. true lets monitors target loopback and private networks
# (localhost, 10.x, 192.168.x, 169.254.169.254, ...). In production this turns
# the service into a proxy into your internal network (SSRF).
ALLOW_PRIVATE_TARGETS=false

# Telegram Bot API token (from @BotFather) used to deliver notifications to
# telegram channels; anyone who knows it controls the bot. Empty disables
# Telegram: deliveries to telegram channels fail. Needed by api (test
# notifications) and worker.
TELEGRAM_BOT_TOKEN=

# --- ops ports (internal only, never publish them) ---

# Ops port: api serves /metrics (and pprof) on :9090, worker serves /healthz,
# /readyz and /metrics on :9091. Each process reads OPS_ADDR; `make run-api`
# and `make run-worker` set it per process to 127.0.0.1:9090 / 127.0.0.1:9091
# and ignore a value here. Set it only when you start the binaries yourself.
# OPS_ADDR=:9090

# true serves the Go profiler on the api ops port (/debug/pprof/). It reveals
# internals and can be made to burn CPU: only on a private ops port.
PPROF_ENABLED=false

# --- worker ---

# Checks running at once. The worker's connection pool grows to at least
# WORKER_CONCURRENCY + 4 connections.
WORKER_CONCURRENCY=20

# Maximum monitors claimed per scheduler tick (once per second).
SCHEDULER_BATCH_SIZE=50

# Check results older than this many days are deleted.
CHECKS_RETENTION_DAYS=30
